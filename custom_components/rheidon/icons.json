{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:ev-plug-type2",
        "state": {
          "charging": "mdi:battery-charging",
          "unplugged": "mdi:power-plug-off",
          "fault": "mdi:alert-circle",
          "emergency_stop": "mdi:alert-octagon",
          "paused": "mdi:pause-circle"
        }
      },
      "charge_start": { "default": "mdi:clock-start" },
      "charge_end": { "default": "mdi:clock-end" }
    },
    "switch": {
      "charging": {
        "default": "mdi:ev-station",
        "state": { "on": "mdi:battery-charging" }
      }
    },
    "select": {
      "mode": { "default": "mdi:car-electric" }
    }
  }
}
